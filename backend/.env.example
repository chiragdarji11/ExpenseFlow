# ==============================================================================
# ExpenseFlow — Backend Environment Configuration Template
# Author & Architect: Chirag Darji (dchirag516@gmail.com)
# ==============================================================================

# Application Configuration
PROJECT_NAME="ExpenseFlow"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL)
# Example Local: mysql+pymysql://root:password@localhost:3306/expense_flow?charset=utf8mb4
# Example Cloud: mysql+pymysql://user:password@cloud-db-host:3306/expense_flow?charset=utf8mb4
DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/expense_flow?charset=utf8mb4"

# Security & Cryptographic JWT Authentication
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="replace-with-a-secure-random-secret-key-minimum-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated list of allowed client origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173"

# Web Push Notifications (RFC 8291/8292 VAPID)
# Keys are automatically generated and stored in vapid_keys.json if left blank.
# For production deployments, specify custom generated VAPID keys:
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@expenseflow.local"

# Background Scheduler Security (Secret key for triggering /api/scheduler/run endpoint)
SCHEDULER_SECRET_KEY="expenseflow-scheduler-internal-secret-2026"
